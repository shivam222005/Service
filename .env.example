# Port configuration (in AI Studio development, dev server binds to 3000; Cloud Run production uses 8080)
PORT=3000
NODE_ENV=development

# JWT Secret for authentication tokens
JWT_SECRET=servicehub-secure-production-jwt-secret-key-replace-in-prod-2026

# SQLite database directory (defaults to ./data/servicehub.db)
DATA_DIR=./data

# Optional: When hosting frontend and backend on separate domains (e.g. Vercel + Render)
# VITE_API_URL=https://api.yourdomain.com

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ServiceHub India UPI & Payment Gateway Configuration
# NPCI UPI VPA for settlement (defaults to servicehub@icici)
SERVICEHUB_UPI_VPA=servicehub@icici
# Razorpay / Gateway test credentials for verified webhooks and payment settlement
RAZORPAY_KEY_ID=rzp_test_servicehub2026
RAZORPAY_KEY_SECRET=rzp_secret_servicehub2026
RAZORPAY_WEBHOOK_SECRET=servicehub_webhook_secret_key
